service vendor.gatekeeper-qti /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64:/vendor/odm/lib64:/bin
    seclabel u:r:recovery:s0
    disabled
