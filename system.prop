# Keystore / Keymaster
fbe.metadata.wrappedkey=true

# Gatekeeper
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# Logging
persist.sys.qseelogd=true
persist.logd.size=8M

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Charger suspend 
ro.charger.enable_suspend=1

# ADB
ro.adb.secure=0
